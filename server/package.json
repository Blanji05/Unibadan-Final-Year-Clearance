{
  "name": "clearance-system-server",
  "version": "1.0.0",
  "description": "Backend API for the University of Ibadan Student Clearance Management System",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/initDb.js --drop && node scripts/seed.js",
    "db:migrate-remita": "node scripts/migrate-remita.js",
    "db:migrate-features": "node scripts/migrate-features.js",
    "check:payments": "node scripts/check-payment-flow.js",
    "check:requirements": "node scripts/check-requirements-flow.js",
    "check:admin": "node scripts/check-admin-flow.js",
    "check:notifications": "node scripts/check-notifications.js",
    "check:e2e": "node scripts/e2e-check.js",
    "cleanup:test-data": "node scripts/cleanup-test-data.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "docx": "^9.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.15.2"
  }
}
