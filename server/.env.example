# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Blaques05.
DB_NAME=clearance_db

# ---- Auth ----
# Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Cloudinary (optional) ----
# Leave blank to store uploads on local disk at server/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Remita (optional) ----
# Leave blank to run payments in simulated mode (no real charge, for demos).
# REMITA_ENV is "demo" (test environment) or "live".
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
REMITA_ENV=demo

# ---- Termii SMS (optional) ----
# Leave blank to log notifications to the console instead of sending SMS.
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# ---- Email / SMTP (optional) ----
# Leave blank to log notification emails to the console instead of sending.
# Example host for Gmail: smtp.gmail.com, port 587, secure=false, and an
# App Password in SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UI Clearance <no-reply@clearance.ui.edu.ng>

# ---- Seeding ----
# Password given to every account created by `npm run db:seed`.
SEED_PASSWORD=Password123!
